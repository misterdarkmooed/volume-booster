@echo off\nchcp 65001 >nul\ncolor 0A\ncls\n:menu\necho.\necho ╔════════════════════════════════════╗\necho ║      VOLUME BOOSTER - WINDOWS      ║\necho ╚════════════════════════════════════╝\necho.\necho 1 - Subir volumen al maximo\necho 2 - Bajar volumen\necho 3 - Volumen normal\necho 4 - Salir\necho.\nset /p opcion=\"Elige una opcion (1-4): \"\n\nif \"%opcion%\"==\"1\" (\n    powershell -Command \"[Windows.Media.SystemMediaTransportControls,Windows.Media,ContentType=WindowsRuntime] > $null; (New-Object Windows.Media.SystemMediaTransportControls).Volume = 100\"\n    echo.\n    echo ✓ Volumen al MAXIMO\n    echo.\n    timeout /t 2 /nobreak\n    goto menu\n)\n\nif \"%opcion%\"==\"2\" (\n    powershell -Command \"[Windows.Media.SystemMediaTransportControls,Windows.Media,ContentType=WindowsRuntime] > $null; (New-Object Windows.Media.SystemMediaTransportControls).Volume = 30\"\n    echo.\n    echo ✓ Volumen BAJO\n    echo.\n    timeout /t 2 /nobreak\n    goto menu\n)\n\nif \"%opcion%\"==\"3\" (\n    powershell -Command \"[Windows.Media.SystemMediaTransportControls,Windows.Media,ContentType=WindowsRuntime] > $null; (New-Object Windows.Media.SystemMediaTransportControls).Volume = 50\"\n    echo.\n    echo ✓ Volumen NORMAL\n    echo.\n    timeout /t 2 /nobreak\n    goto menu\n)\n\nif \"%opcion%\"==\"4\" (\n    exit /b\n)\n\necho Opcion no valida\ntimeout /t 2 /nobreak\ngoto menu\n